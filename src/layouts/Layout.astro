---
import '../styles/global.css';
import '../styles/hover.css';
import { facebookUrl } from '../config';

interface Props {
  title: string;
  description?: string;
  active?: 'about' | 'services' | 'programs' | 'pricing' | 'contact';
}
const { title, description = 'Authentic, hands-on learning built on real-life skills. Classes, tutoring, planning, and coaching for every learner. Offered live in-person and virtually, plus many resources on-demand.', active } = Astro.props;

const links = [
  { key: 'about', href: '/about/', label: 'About', hover: '#FCE8F2' },
  { key: 'services', href: '/services/', label: 'Services', hover: '#FFF1E9' },
  { key: 'programs', href: '/programs/', label: 'Programs', hover: '#FFF8DC' },
  { key: 'pricing', href: '/pricing/', label: 'Pricing', hover: '#E3FBF8' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/images/logo-g.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght,SOFT@0,9..144,400..900,0..100;1,9..144,400..900,0..100&family=DM+Sans:opsz,wght@9..40,400..700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="site-header">
      <nav class="site-nav" aria-label="Main">
        <a href="/" class="brand">
          <img src="/images/logo-goodmess.png" alt="" />
          <span class="brand-text">Good Mess Learning</span>
        </a>
        <div class="nav-pill">
          {links.map((l) => (
            <a href={l.href} class="nav-link" style={`--hover:${l.hover}`} aria-current={active === l.key ? 'page' : undefined}>{l.label}</a>
          ))}
          <a href="/contact/" class="nav-cta">Book a call</a>
        </div>
      </nav>
    </header>
    <div style="max-width:1280px;margin:0 auto;overflow:hidden">

      <slot />

      <footer style="padding:0 56px 40px;display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:24px;font-size:15px">
        <span style="color:#4A3F4E;font-size:14px">© 2026 Good Mess Learning · Central Florida</span>
        <div style="display:flex;flex-wrap:wrap;gap:24px">
          <a class="foot-link" href="/about/">About</a>
          <a class="foot-link" href="/services/">Services</a>
          <a class="foot-link" href="/programs/">Programs</a>
          <a class="foot-link" href="/pricing/">Pricing</a>
          <a class="foot-link" href="/contact/">Contact</a>
          <a class="foot-link" href={facebookUrl} target="_blank" rel="noopener noreferrer">Facebook</a>
        </div>
      </footer>
    </div>
  </body>
</html>

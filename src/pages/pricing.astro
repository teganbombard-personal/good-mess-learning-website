---
import Layout from '../layouts/Layout.astro';
import { links } from '../config';

type Row = { name: string; note?: string; price?: string; detail?: string };
const groups: { title: string; color: string; rows: Row[]; inquire?: boolean }[] = [
  { title: 'Private tutoring', color: '#E8359A', rows: [
    { name: 'Elementary', price: '$70 / hour' },
    { name: 'Middle school', price: '$90 / hour' },
    { name: 'High school', price: '$110 / hour' },
  ] },
  { title: 'Small group classes', color: '#FF6B35', rows: [
    { name: 'In person', note: 'supplies included', price: '$30 / hour' },
    { name: 'Virtual', note: 'supplies not included', price: '$15 / hour' },
  ] },
  { title: 'Planning & coaching', color: '#FFD23F', rows: [
    { name: '1:1 Curriculum Consult', price: '$65' },
    { name: 'New Family Onboarding', price: '$85' },
    { name: 'Annual Kickoff Session', price: '$95' },
    { name: 'Monthly Planning', price: '$150 / month' },
    { name: 'Multi-Child Monthly Planning', note: '2+ children', price: '$200 / month' },
    { name: 'Full-Year Roadmap', price: '$750 / year' },
  ] },
  { title: 'On-demand', color: '#0BBFB0', rows: [
    { name: 'On-demand with feedback', price: '$50 / week' },
    { name: 'On-demand without feedback', price: '$50 / month' },
    { name: 'Monthly on-demand with feedback', price: '$150 / month' },
  ] },
  { title: 'Additional services', color: '#3E2F50', inquire: true, rows: [
    { name: 'Workshops' },
    { name: 'Family packages' },
    { name: 'Custom' },
  ] },
];
---
<Layout title="Pricing & Funding | Good Mess Learning" active="pricing">
<header style="position:relative;padding:56px 56px 88px;display:flex;flex-direction:column;gap:22px">
<div data-sticker="true" style="position:absolute;right:80px;top:60px;transform:rotate(-9deg);background:#E8359A;color:#FDFAF6;width:124px;height:124px;border-radius:50%;display:flex;align-items:center;justify-content:center;text-align:center;font-family:'Fraunces',serif;font-weight:800;font-size:19px;line-height:1.05">ESA<br>eligible</div><div data-sticker="true" style="position:absolute;right:240px;top:170px;transform:rotate(7deg);background:#FFD23F;color:#1A1220;padding:12px 20px;border-radius:14px;font-family:'Fraunces',serif;font-weight:800;font-size:20px">free intro call</div>
<div style="position:relative;font-weight:700;font-size:13px;letter-spacing:.12em;text-transform:uppercase;color:#B8246F">Pricing</div>
<h1 style="position:relative;margin:0;max-width:820px;font-family:'Fraunces',serif;font-variation-settings:'SOFT' 100;font-weight:900;font-size:clamp(52px,7vw,92px);line-height:.96;letter-spacing:-.03em;color:#1A1220;text-wrap:balance">Clear prices. <em style="color:#E8359A">Three</em> ways to pay.</h1>
<p style="position:relative;margin:0;max-width:620px;font-size:20px;line-height:1.6;color:#4A3F4E;text-wrap:pretty">Pay out of pocket, use your Florida ESA, or put scholarship funds to work. If you're not sure which fits, we'll walk you through it on a free call.</p>
</header><section style="padding:0 56px 112px;display:flex;flex-direction:column;gap:40px">
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr));gap:28px">
<div style="background:#fff;border:3px solid #1A1220;border-radius:20px;box-shadow:6px 6px 0 #E8359A;padding:28px;display:flex;flex-direction:column;gap:12px"><span style="font-family:'Fraunces',serif;font-style:italic;font-weight:800;font-size:40px;color:#E8359A">01</span><h3 style="margin:0;font-family:'Fraunces',serif;font-weight:700;font-size:24px;line-height:1.15;color:#1A1220">Out of pocket</h3><div style="font-size:15px;line-height:1.6;color:#4A3F4E;display:flex;flex-direction:column;gap:10px"><p style="margin:0">Pay per session, per month, or per program. No contracts on tutoring or classes.</p></div><a href="#prices" style="margin-top:auto;font-weight:700">See all prices →</a></div>
<div style="background:#fff;border:3px solid #1A1220;border-radius:20px;box-shadow:6px 6px 0 #FF6B35;padding:28px;display:flex;flex-direction:column;gap:12px"><span style="font-family:'Fraunces',serif;font-style:italic;font-weight:800;font-size:40px;color:#FF6B35">02</span><h3 style="margin:0;font-family:'Fraunces',serif;font-weight:700;font-size:24px;line-height:1.15;color:#1A1220">Florida ESA</h3><div style="font-size:15px;line-height:1.6;color:#4A3F4E;display:flex;flex-direction:column;gap:10px"><p style="margin:0">Every service is FES-UA &amp; PEP eligible. Pre-purchase directly through the Step Up for Students EMA portal.</p></div><a href="#esa" style="margin-top:auto;font-weight:700">How to pay with your ESA →</a></div>
<div style="background:#fff;border:3px solid #1A1220;border-radius:20px;box-shadow:6px 6px 0 #0BBFB0;padding:28px;display:flex;flex-direction:column;gap:12px"><span style="font-family:'Fraunces',serif;font-style:italic;font-weight:800;font-size:40px;color:#089A8E">03</span><h3 style="margin:0;font-family:'Fraunces',serif;font-weight:700;font-size:24px;line-height:1.15;color:#1A1220">Scholarships</h3><div style="font-size:15px;line-height:1.6;color:#4A3F4E;display:flex;flex-direction:column;gap:10px"><p style="margin:0">Starting in 2027, new scholarship funds for K–12 services, including tutoring, become available in participating states.</p></div><a href="#scholarships" style="margin-top:auto;font-weight:700">How scholarships work →</a></div>
</div>
</section>
<section id="prices" style="padding:0 56px 112px;display:flex;flex-direction:column;gap:40px;scroll-margin-top:24px">
<div style="display:flex;flex-wrap:wrap;justify-content:space-between;align-items:flex-end;gap:24px"><h2 style="margin:0;font-family:'Fraunces',serif;font-variation-settings:'SOFT' 100;font-weight:800;font-size:clamp(40px,5vw,52px);line-height:1.04;color:#1A1220;">Packages &amp; prices</h2><p style="margin:0;max-width:420px;font-size:16px;line-height:1.6;color:#4A3F4E">Most families start with one service and add as they go. Every price below is ESA eligible.</p></div>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,360px),1fr));gap:28px;align-items:start">
{groups.map((g) => (
<div style={`background:#fff;padding:28px;box-shadow:0 10px 30px rgba(26,18,32,.08);border-top:10px solid ${g.color};display:flex;flex-direction:column;gap:6px`}>
<h3 style="margin:0 0 6px;font-family:'Fraunces',serif;font-weight:700;font-size:23px;color:#1A1220">{g.title}</h3>
<div style="font-size:15px;color:#4A3F4E">
{g.rows.map((r) => (
<div style="display:flex;justify-content:space-between;align-items:center;gap:16px;padding:12px 0;border-bottom:1px solid #EDE3EA">
<span>{r.name}{r.note && <span style="color:#7A6D7E;font-size:13px"> · {r.note}</span>}</span>
{r.price && <strong style="color:#1A1220;white-space:nowrap">{r.price}</strong>}
{g.inquire && <a class="btn-line" style="padding:8px 16px;font-size:14px" href={links.inquire}>Inquire</a>}
</div>
))}
</div>
</div>
))}
</div>
</section>
<div id="esa" style="scroll-margin-top:24px"><section style="background:#3E2F50;padding:96px 56px;display:flex;flex-direction:column;gap:40px;position:relative;overflow:hidden"><div style="position:absolute;right:-160px;top:-160px;width:480px;height:480px;border-radius:50%;background:#652F63"></div><div style="position:relative;display:flex;flex-direction:column;gap:40px"><div style="display:flex;flex-direction:column;gap:14px;max-width:720px"><div style="font-weight:700;font-size:13px;letter-spacing:.12em;text-transform:uppercase;color:#FFD23F">Florida families</div><h2 style="margin:0;font-family:'Fraunces',serif;font-variation-settings:'SOFT' 100;font-weight:800;font-size:clamp(40px,5vw,52px);line-height:1.04;color:#1A1220;color:#FDFAF6">Paying with your ESA</h2><p style="margin:0;font-size:18px;line-height:1.6;color:#E9E2EC">Good Mess Learning is an approved provider for FES-UA and PEP scholarships through Step Up for Students. Funds go straight from your account to us, with no reimbursement wait.</p></div>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,220px),1fr));gap:24px">
<div style="border-top:4px solid #E8359A;padding-top:18px;display:flex;flex-direction:column;gap:8px"><span style="font-family:'Fraunces',serif;font-style:italic;font-weight:800;font-size:28px;color:#E8359A">01</span><h3 style="margin:0;font-family:'Fraunces',serif;font-weight:700;font-size:21px;color:#FDFAF6">Log in to EMA</h3><p style="margin:0;font-size:15px;line-height:1.55;color:#E9E2EC">Sign in to your Step Up for Students account and open the EMA portal.</p></div>
<div style="border-top:4px solid #FF6B35;padding-top:18px;display:flex;flex-direction:column;gap:8px"><span style="font-family:'Fraunces',serif;font-style:italic;font-weight:800;font-size:28px;color:#FF6B35">02</span><h3 style="margin:0;font-family:'Fraunces',serif;font-weight:700;font-size:21px;color:#FDFAF6">Search the Provider area</h3><p style="margin:0;font-size:15px;line-height:1.55;color:#E9E2EC">Search <strong style="color:#FDFAF6">Good Mess Learning</strong>.</p></div>
<div style="border-top:4px solid #FFD23F;padding-top:18px;display:flex;flex-direction:column;gap:8px"><span style="font-family:'Fraunces',serif;font-style:italic;font-weight:800;font-size:28px;color:#FFD23F">03</span><h3 style="margin:0;font-family:'Fraunces',serif;font-weight:700;font-size:21px;color:#FDFAF6">Pre-purchase the service</h3><p style="margin:0;font-size:15px;line-height:1.55;color:#E9E2EC">Choose the service and amount you want to reserve.</p></div>
<div style="border-top:4px solid #0BBFB0;padding-top:18px;display:flex;flex-direction:column;gap:8px"><span style="font-family:'Fraunces',serif;font-style:italic;font-weight:800;font-size:28px;color:#0BBFB0">04</span><h3 style="margin:0;font-family:'Fraunces',serif;font-weight:700;font-size:21px;color:#FDFAF6">We confirm &amp; schedule</h3><p style="margin:0;font-size:15px;line-height:1.55;color:#E9E2EC">We’ll reach out within a day to set up sessions.</p></div>
</div></div></section></div>
<section id="scholarships" style="padding:112px 56px;scroll-margin-top:24px">
<div style="background:#fff;border:3px solid #1A1220;border-radius:28px;box-shadow:10px 10px 0 #0BBFB0;padding:56px;display:flex;flex-direction:column;gap:36px">
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,380px),1fr));gap:40px;align-items:start">
<div style="display:flex;flex-direction:column;gap:14px"><div style="align-self:flex-start;background:#E3FBF8;padding:6px 14px;border-radius:999px;font-weight:700;font-size:13px">New for 2027</div><h2 style="margin:0;font-family:'Fraunces',serif;font-variation-settings:'SOFT' 100;font-weight:800;font-size:clamp(40px,5vw,52px);line-height:1.04;color:#1A1220;">Scholarships</h2></div>
<div style="display:flex;flex-direction:column;gap:14px;font-size:17px;line-height:1.6;color:#4A3F4E"><p style="margin:0">Starting January 1, 2027, educational scholarships will be available to many learners across the U.S. as part of the Educational Choice for Children Act. Join one of our live webinars to learn more.</p><div style="display:flex;flex-wrap:wrap;align-items:center;gap:12px 16px;margin-top:6px"><a class="btn-solid" href={links.webinar}>Register for a live webinar</a><span style="font-size:15px;color:#7A6D7E">Date &amp; time coming soon</span></div></div>
</div>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,220px),1fr));gap:24px">
<div style="border-top:4px solid #E8359A;padding-top:18px;display:flex;flex-direction:column;gap:8px"><span style="font-family:'Fraunces',serif;font-style:italic;font-weight:800;font-size:28px;color:#1A1220">01</span><h3 style="margin:0;font-family:'Fraunces',serif;font-weight:700;font-size:21px;color:#1A1220">Check your state</h3><p style="margin:0;font-size:15px;line-height:1.55;color:#4A3F4E">Your state has to opt in to the program. We’ll keep this page updated for Florida.</p></div>
<div style="border-top:4px solid #FF6B35;padding-top:18px;display:flex;flex-direction:column;gap:8px"><span style="font-family:'Fraunces',serif;font-style:italic;font-weight:800;font-size:28px;color:#1A1220">02</span><h3 style="margin:0;font-family:'Fraunces',serif;font-weight:700;font-size:21px;color:#1A1220">Apply to an SGO</h3><p style="margin:0;font-size:15px;line-height:1.55;color:#4A3F4E">Families apply directly to a scholarship organization in their state.</p></div>
<div style="border-top:4px solid #FFD23F;padding-top:18px;display:flex;flex-direction:column;gap:8px"><span style="font-family:'Fraunces',serif;font-style:italic;font-weight:800;font-size:28px;color:#1A1220">03</span><h3 style="margin:0;font-family:'Fraunces',serif;font-weight:700;font-size:21px;color:#1A1220">Get your award</h3><p style="margin:0;font-size:15px;line-height:1.55;color:#4A3F4E">The SGO decides awards and sets which services and providers qualify.</p></div>
<div style="border-top:4px solid #0BBFB0;padding-top:18px;display:flex;flex-direction:column;gap:8px"><span style="font-family:'Fraunces',serif;font-style:italic;font-weight:800;font-size:28px;color:#1A1220">04</span><h3 style="margin:0;font-family:'Fraunces',serif;font-weight:700;font-size:21px;color:#1A1220">Use it with us</h3><p style="margin:0;font-size:15px;line-height:1.55;color:#4A3F4E">Pay for eligible services with your scholarship funds.</p></div>
</div>
<p style="margin:0;font-size:14px;color:#7A6D7E">Program rules are still being finalized. This isn't tax or legal advice; check with your SGO for eligibility.</p>
</div>
</section>
<section style="padding:0 56px 112px">
<div style="background:#FFF8DC;border-radius:28px;padding:40px 48px;display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:24px;transform:rotate(-0.6deg)">
<div style="display:flex;flex-direction:column;gap:8px;max-width:720px"><h3 style="margin:0;font-family:'Fraunces',serif;font-weight:800;font-size:30px;color:#1A1220">Outside Florida?</h3><p style="margin:0;font-size:16px;line-height:1.6;color:#4A3F4E">Many states offer ESAs or scholarships that cover virtual tutoring and classes. Tell us your state and we'll help you check what your funds can cover.</p></div>
<a href="/contact/" style="background:#1A1220;color:#FDFAF6;text-decoration:none;padding:15px 26px;border-radius:999px;font-weight:700" data-h="8">Ask about your state</a>
</div>
</section>
<section style="padding:0 56px 112px;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,380px),1fr));gap:48px;align-items:start">
<h2 style="margin:0;font-family:'Fraunces',serif;font-variation-settings:'SOFT' 100;font-weight:800;font-size:clamp(40px,5vw,52px);line-height:1.04;color:#1A1220;">Questions families ask</h2>
<div style="display:flex;flex-direction:column;border-top:2px solid #1A1220">
<details class="faq" style="border-bottom:2px solid #1A1220" open>
<summary style="display:flex;justify-content:space-between;align-items:center;gap:16px;padding:22px 0;color:#1A1220"><span style="font-family:'Fraunces',serif;font-weight:700;font-size:21px">Can I use my ESA for everything?</span><span class="faq-sign" aria-hidden="true" style="flex:none;width:32px;height:32px;border-radius:50%;background:#FCE8F2;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:18px"></span></summary>
<p style="margin:0 0 22px;font-size:16px;line-height:1.6;color:#4A3F4E;max-width:640px">Yes. Every Good Mess Learning service can be pre-purchased through the Step Up for Students EMA portal with FES-UA or PEP funds.</p>
</details>
<details class="faq" style="border-bottom:2px solid #1A1220">
<summary style="display:flex;justify-content:space-between;align-items:center;gap:16px;padding:22px 0;color:#1A1220"><span style="font-family:'Fraunces',serif;font-weight:700;font-size:21px">My kids go to public school. Can we still work with you?</span><span class="faq-sign" aria-hidden="true" style="flex:none;width:32px;height:32px;border-radius:50%;background:#FFF1E9;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:18px"></span></summary>
<p style="margin:0 0 22px;font-size:16px;line-height:1.6;color:#4A3F4E;max-width:640px">Absolutely. Tutoring, enrichment, and assessments are open to every learner. Pay out of pocket, or with scholarship funds where eligible.</p>
</details>
<details class="faq" style="border-bottom:2px solid #1A1220">
<summary style="display:flex;justify-content:space-between;align-items:center;gap:16px;padding:22px 0;color:#1A1220"><span style="font-family:'Fraunces',serif;font-weight:700;font-size:21px">Do you offer pricing for multiple kids?</span><span class="faq-sign" aria-hidden="true" style="flex:none;width:32px;height:32px;border-radius:50%;background:#FFF8DC;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:18px"></span></summary>
<p style="margin:0 0 22px;font-size:16px;line-height:1.6;color:#4A3F4E;max-width:640px">Yes, family pricing is available upon request for multiple children. Please reach out to request this.</p>
</details>
<details class="faq" style="border-bottom:2px solid #1A1220">
<summary style="display:flex;justify-content:space-between;align-items:center;gap:16px;padding:22px 0;color:#1A1220"><span style="font-family:'Fraunces',serif;font-weight:700;font-size:21px">Is the intro call really free?</span><span class="faq-sign" aria-hidden="true" style="flex:none;width:32px;height:32px;border-radius:50%;background:#E3FBF8;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:18px"></span></summary>
<p style="margin:0 0 22px;font-size:16px;line-height:1.6;color:#4A3F4E;max-width:640px">Yes. It’s a free 30-minute call to talk through where your family is and what kind of support would help.</p>
</details>
<details class="faq" style="border-bottom:2px solid #1A1220">
<summary style="display:flex;justify-content:space-between;align-items:center;gap:16px;padding:22px 0;color:#1A1220"><span style="font-family:'Fraunces',serif;font-weight:700;font-size:21px">What’s your cancellation policy?</span><span class="faq-sign" aria-hidden="true" style="flex:none;width:32px;height:32px;border-radius:50%;background:#FCE8F2;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:18px"></span></summary>
<div style="margin:0 0 22px;font-size:16px;line-height:1.6;color:#4A3F4E;max-width:640px;display:flex;flex-direction:column;gap:10px"><p style="margin:0">Completed services and on-demand services are not refundable.</p><p style="margin:0">For live and virtual sessions:</p><ul style="margin:0;padding-left:22px;display:flex;flex-direction:column;gap:4px"><li>Fully refundable up to 1 week before a session begins</li><li>50% refundable up to 3 days before a session begins</li><li>25% refundable up to 2 days before a session begins</li><li>Not refundable less than 2 days before a session begins</li></ul></div>
</details>
</div>
</section>
<section style="padding:0 56px 96px">
<div style="background:#E8359A;border-radius:40px;padding:72px;display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:40px;position:relative;overflow:hidden">
<div style="position:absolute;right:220px;bottom:-90px;width:200px;height:200px;border-radius:50%;background:#FFD23F"></div>
<h2 style="position:relative;margin:0;font-family:'Fraunces',serif;font-variation-settings:'SOFT' 100;font-weight:900;font-size:56px;line-height:1;color:#FDFAF6;max-width:640px">Talk through your options on a free call.</h2>
<a href="/contact/" style="position:relative;background:#1A1220;color:#FDFAF6;text-decoration:none;padding:18px 32px;border-radius:999px;font-weight:700;font-size:17px;white-space:nowrap" data-h="8">Book a free intro call</a>
</div>
</section>
</Layout>

---
import Layout from '../layouts/Layout.astro';
import { hubspot } from '../config';
---
<Layout title="Contact | Good Mess Learning" active="contact">
<header style="position:relative;padding:56px 56px 88px;display:flex;flex-direction:column;gap:22px">
<div data-sticker="true" style="position:absolute;right:90px;top:60px;transform:rotate(10deg);background:#0BBFB0;color:#1A1220;padding:12px 20px;border-radius:14px;font-family:'Fraunces',serif;font-weight:800;font-size:20px">free · 30 min</div><div data-sticker="true" style="position:absolute;right:250px;top:150px;transform:rotate(-12deg);background:#FFD23F;color:#1A1220;width:124px;height:124px;border-radius:50%;display:flex;align-items:center;justify-content:center;text-align:center;font-family:'Fraunces',serif;font-weight:800;font-size:19px;line-height:1.05">no<br>pressure</div>
<div style="position:relative;font-weight:700;font-size:13px;letter-spacing:.12em;text-transform:uppercase;color:#B8246F">Contact</div>
<h1 style="position:relative;margin:0;max-width:820px;font-family:'Fraunces',serif;font-variation-settings:'SOFT' 100;font-weight:900;font-size:clamp(52px,7vw,92px);line-height:.96;letter-spacing:-.03em;color:#1A1220;text-wrap:balance">Let’s <em style="color:#E8359A">talk.</em></h1>
<p style="position:relative;margin:0;max-width:620px;font-size:20px;line-height:1.6;color:#4A3F4E;text-wrap:pretty">Book a free 30-minute intro call or send a message. We usually reply within a day.</p>
</header><section style="padding:0 56px 96px;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,440px),1fr));gap:40px;align-items:start">
<div style="background:#fff;border:3px solid #1A1220;border-radius:24px;box-shadow:8px 8px 0 #E8359A;padding:32px;display:flex;flex-direction:column;gap:20px">
<div style="display:flex;flex-direction:column;gap:6px"><h2 style="margin:0;font-family:'Fraunces',serif;font-variation-settings:'SOFT' 100;font-weight:800;font-size:32px;color:#1A1220">Book an intro call</h2><p style="margin:0;font-size:15px;line-height:1.55;color:#4A3F4E">Pick a time that works. We'll talk about your learner, your schooling setup, and what kind of support fits.</p></div>
<div class="meetings-iframe-container" data-src="https://meetings-na2.hubspot.com/tegan-bombard?embed=true" style="min-height:460px"></div>
<script is:inline type="text/javascript" src="https://static.hsappstatic.net/MeetingsEmbed/ex/MeetingsEmbedCode.js"></script>
<p style="margin:0;font-size:14px;color:#4A3F4E">Calendar not loading? <a href="https://meetings-na2.hubspot.com/tegan-bombard" target="_blank" rel="noopener">Open it in a new tab →</a></p>
</div>
<div style="background:#fff;border-radius:24px;box-shadow:0 10px 30px rgba(26,18,32,.08);padding:32px;display:flex;flex-direction:column;gap:20px">

<form id="contact-form" name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field" action="/thanks/" data-hs-portal={hubspot.portalId} data-hs-form={hubspot.formId} style="display:flex;flex-direction:column;gap:18px">
<input type="hidden" name="form-name" value="contact">
<p hidden><label>Don’t fill this out: <input name="bot-field"></label></p>
<input type="hidden" name="request_type" value="">
<input type="hidden" name="program" value="">
<input type="hidden" name="session" value="">
<input type="hidden" name="hubspot_status" value="">
<div style="display:flex;flex-direction:column;gap:6px"><h2 style="margin:0;font-family:'Fraunces',serif;font-variation-settings:'SOFT' 100;font-weight:800;font-size:32px;color:#1A1220">Send a message</h2></div>
<p id="context" hidden style="margin:0;background:#FFF8DC;border-radius:12px;padding:12px 16px;font-weight:700;font-size:15px;color:#1A1220"></p>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,200px),1fr));gap:16px"><label style="display:flex;flex-direction:column;gap:6px;font-weight:700;font-size:14px;color:#1A1220">First name<input name="firstname" autocomplete="given-name" required style="padding:13px 14px;border:2px solid #1A1220;border-radius:12px;background:#FDFAF6;font-size:16px;font-weight:400;color:#1A1220"></label><label style="display:flex;flex-direction:column;gap:6px;font-weight:700;font-size:14px;color:#1A1220">Last name<input name="lastname" autocomplete="family-name" required style="padding:13px 14px;border:2px solid #1A1220;border-radius:12px;background:#FDFAF6;font-size:16px;font-weight:400;color:#1A1220"></label></div>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,200px),1fr));gap:16px"><label style="display:flex;flex-direction:column;gap:6px;font-weight:700;font-size:14px;color:#1A1220">Email<input type="email" name="email" autocomplete="email" required style="padding:13px 14px;border:2px solid #1A1220;border-radius:12px;background:#FDFAF6;font-size:16px;font-weight:400;color:#1A1220"></label><label style="display:flex;flex-direction:column;gap:6px;font-weight:700;font-size:14px;color:#1A1220">Learner grade(s)<input name="grades" placeholder="e.g. 2nd and 6th" style="padding:13px 14px;border:2px solid #1A1220;border-radius:12px;background:#FDFAF6;font-size:16px;font-weight:400;color:#1A1220"></label></div>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,200px),1fr));gap:16px"><label style="display:flex;flex-direction:column;gap:6px;font-weight:700;font-size:14px;color:#1A1220">Schooling setup<select name="schooling_setup" style="padding:13px 14px;border:2px solid #1A1220;border-radius:12px;background:#FDFAF6;font-size:16px;font-weight:400;color:#1A1220"><option>Homeschool</option><option>Public school</option><option>Private school</option><option>Hybrid / in between</option><option>School or co-op (workshops)</option></select></label><label style="display:flex;flex-direction:column;gap:6px;font-weight:700;font-size:14px;color:#1A1220">I'm interested in<select name="interest" style="padding:13px 14px;border:2px solid #1A1220;border-radius:12px;background:#FDFAF6;font-size:16px;font-weight:400;color:#1A1220"><option>Not sure yet</option><option>Annual homeschool evaluation</option><option>Private tutoring</option><option>Small-group classes</option><option>Learning assessment</option><option>Homeschool consulting / planning</option><option>Parent coaching</option><option>Workshops for schools &amp; co-ops</option></select></label></div>
<fieldset style="border:none;margin:0;padding:0;display:flex;flex-direction:column;gap:10px"><legend style="font-weight:700;font-size:14px;margin-bottom:10px">How do you plan to pay?</legend><div style="display:flex;flex-wrap:wrap;gap:10px"><label style="display:flex;align-items:center;gap:8px;border:2px solid #1A1220;border-radius:999px;padding:8px 14px;font-size:14px;cursor:pointer"><input type="radio" name="funding" value="Out of pocket" style="accent-color:#E8359A">Out of pocket</label><label style="display:flex;align-items:center;gap:8px;border:2px solid #1A1220;border-radius:999px;padding:8px 14px;font-size:14px;cursor:pointer"><input type="radio" name="funding" value="Step Up scholarship (FES-UA, FES-EO, or PEP)" style="accent-color:#E8359A">Step Up scholarship (FES-UA, FES-EO, or PEP)</label><label style="display:flex;align-items:center;gap:8px;border:2px solid #1A1220;border-radius:999px;padding:8px 14px;font-size:14px;cursor:pointer"><input type="radio" name="funding" value="Other scholarship or ESA" style="accent-color:#E8359A">Other scholarship or ESA</label><label style="display:flex;align-items:center;gap:8px;border:2px solid #1A1220;border-radius:999px;padding:8px 14px;font-size:14px;cursor:pointer"><input type="radio" name="funding" value="Not sure" style="accent-color:#E8359A">Not sure</label></div></fieldset>
<label style="display:flex;flex-direction:column;gap:6px;font-weight:700;font-size:14px;color:#1A1220">Message<textarea name="message" rows="5" placeholder="Tell us a bit about your family and what you're looking for." style="padding:13px 14px;border:2px solid #1A1220;border-radius:12px;background:#FDFAF6;font-size:16px;font-weight:400;color:#1A1220;resize:vertical"></textarea></label>
<p id="form-error" role="alert" hidden style="margin:0;color:#B8246F;font-weight:700;font-size:15px">Something went wrong sending that. Please try again in a moment.</p>
<button type="submit" style="background:#E8359A;color:#FDFAF6;border:none;padding:16px 28px;border-radius:999px;font-weight:700;font-size:16px;cursor:pointer" data-h="10">Send message</button>
</form>


</div>
</section>
<section style="padding:0 56px 112px;display:flex;flex-direction:column;gap:32px">
<h2 style="margin:0;font-family:'Fraunces',serif;font-variation-settings:'SOFT' 100;font-weight:800;font-size:clamp(40px,5vw,52px);line-height:1.04;color:#1A1220;">What happens next</h2>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,240px),1fr));gap:24px">
<div style="border-top:4px solid #E8359A;padding-top:18px;display:flex;flex-direction:column;gap:8px"><span style="font-family:'Fraunces',serif;font-style:italic;font-weight:800;font-size:28px;color:#1A1220">01</span><h3 style="margin:0;font-family:'Fraunces',serif;font-weight:700;font-size:21px;color:#1A1220">We say hello</h3><p style="margin:0;font-size:15px;line-height:1.55;color:#4A3F4E">A reply within a day, by email or text.</p></div>
<div style="border-top:4px solid #FF6B35;padding-top:18px;display:flex;flex-direction:column;gap:8px"><span style="font-family:'Fraunces',serif;font-style:italic;font-weight:800;font-size:28px;color:#1A1220">02</span><h3 style="margin:0;font-family:'Fraunces',serif;font-weight:700;font-size:21px;color:#1A1220">Free intro call</h3><p style="margin:0;font-size:15px;line-height:1.55;color:#4A3F4E">30 minutes about your learner and what fits.</p></div>
<div style="border-top:4px solid #FFD23F;padding-top:18px;display:flex;flex-direction:column;gap:8px"><span style="font-family:'Fraunces',serif;font-style:italic;font-weight:800;font-size:28px;color:#1A1220">03</span><h3 style="margin:0;font-family:'Fraunces',serif;font-weight:700;font-size:21px;color:#1A1220">A plan you can use</h3><p style="margin:0;font-size:15px;line-height:1.55;color:#4A3F4E">A recommended mix of classes, tutoring, or coaching.</p></div>
<div style="border-top:4px solid #0BBFB0;padding-top:18px;display:flex;flex-direction:column;gap:8px"><span style="font-family:'Fraunces',serif;font-style:italic;font-weight:800;font-size:28px;color:#1A1220">04</span><h3 style="margin:0;font-family:'Fraunces',serif;font-weight:700;font-size:21px;color:#1A1220">Start learning</h3><p style="margin:0;font-size:15px;line-height:1.55;color:#4A3F4E">Book directly, or pre-purchase with your ESA.</p></div>
</div>
</section>
<script is:inline>
  (function () {
    var form = document.getElementById('contact-form');
    var params = new URLSearchParams(location.search);
    var clean = function (v) { return (v || '').slice(0, 200); };
    var types = {
      'waitlist': 'Join the waitlist',
      'sign-up-with-feedback': 'Sign up with feedback',
      'sign-up-without-feedback': 'Sign up without feedback',
      'request-a-time': 'Request a time',
      'inquiry': 'Inquiry',
      'webinar': 'Webinar registration'
    };
    var label = types[params.get('type')] || '';
    var program = clean(params.get('program'));
    var session = clean(params.get('session'));
    var interest = params.get('interest');

    // Prefill from the link the visitor came in on.
    form.elements.request_type.value = label || 'General message';
    form.elements.program.value = program;
    form.elements.session.value = session;
    if (interest) {
      var opts = form.elements.interest.options;
      for (var i = 0; i < opts.length; i++) {
        if (opts[i].value === interest) form.elements.interest.value = interest;
      }
    }
    if (label) {
      var ctx = document.getElementById('context');
      ctx.textContent = label + (program ? ': ' + program : '') + (session ? ' (' + session + ')' : '');
      ctx.hidden = false;
    }

    var hubspotFields = ['firstname', 'lastname', 'email', 'grades', 'schooling_setup', 'interest', 'funding', 'message', 'request_type', 'program', 'session'];
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      if (form.elements['bot-field'].value) return;
      var btn = form.querySelector('button[type=submit]');
      var err = document.getElementById('form-error');
      err.hidden = true;
      btn.disabled = true;
      btn.textContent = 'Sending…';

      var fields = [];
      hubspotFields.forEach(function (n) {
        var el = form.elements[n];
        var v = el && el.value ? el.value.trim() : '';
        if (v) fields.push({ name: n, value: v });
      });
      var hutk = (document.cookie.match(/(?:^|; )hubspotutk=([^;]+)/) || [])[1];
      var context = { pageUri: location.href, pageName: document.title };
      if (hutk) context.hutk = hutk;

      // HubSpot first, so the Netlify backup copy can record whether it worked.
      var toHubspot = fetch('https://api.hsforms.com/submissions/v3/integration/submit/' + form.dataset.hsPortal + '/' + form.dataset.hsForm, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ fields: fields, context: context })
      }).then(function (r) {
        if (r.ok) { form.elements.hubspot_status.value = 'ok'; return; }
        return r.text().then(function (t) { throw new Error('hubspot ' + r.status + ' ' + t.slice(0, 300)); });
      }).catch(function (e) {
        form.elements.hubspot_status.value = 'failed: ' + (e && e.message ? e.message : e);
        console.error('HubSpot submit failed', e);
        throw e;
      });

      // Netlify Forms keeps a backup copy of every submission.
      var toNetlify = toHubspot.catch(function () {}).then(function () {
        return fetch('/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams(new FormData(form)).toString()
        });
      }).then(function (r) { if (!r.ok) throw new Error('netlify ' + r.status); });

      Promise.allSettled([toHubspot, toNetlify]).then(function (res) {
        if (res[0].status === 'fulfilled' || res[1].status === 'fulfilled') {
          location.href = '/thanks/';
        } else {
          err.hidden = false;
          btn.disabled = false;
          btn.textContent = 'Send message';
        }
      });
    });
  })();
</script>
</Layout>

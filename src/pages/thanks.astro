---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Thank you | Good Mess Learning">
<section style="padding:48px 56px 112px;display:flex;justify-content:center">
<div style="background:#fff;border-radius:24px;box-shadow:0 10px 30px rgba(26,18,32,.08);padding:32px;width:100%;max-width:560px">
<div style="min-height:420px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px;text-align:center"><img src="/images/logo-g.png" alt="" style="width:88px;height:88px;transform:rotate(-8deg)"><h2 style="margin:0;font-family:'Fraunces',serif;font-variation-settings:'SOFT' 100;font-weight:800;font-size:36px">Got it. Thank you!</h2><p style="margin:0;max-width:360px;color:#4A3F4E;line-height:1.6">We'll reply within a day. In the meantime, feel free to <a href="/contact/">grab a call time</a>.</p><a href="/contact/" style="font-weight:700;font-size:15px">Back to contact</a></div>
</div>
</section>
</Layout>

---
import Layout from '../layouts/Layout.astro';
import { contactLink } from '../config';

// Class catalog. Scheduled classes have no dates yet, so they show "Now forming" and a waitlist button.
const colors: Record<string, [string, string]> = {
  Math: ['#FF6B35', '#FFF1E9'],
  Science: ['#0BBFB0', '#E3FBF8'],
  ELA: ['#E8359A', '#FCE8F2'],
  'Social Studies': ['#FFD23F', '#FFF8DC'],
  Art: ['#E5484D', '#FDECEC'],
  Electives: ['#3E2F50', '#EDE6F0'],
};
// Top edge of a card: one color per subject, in equal segments.
const stripe = (subs: string[]) =>
  `linear-gradient(90deg, ${subs.map((x, i) => `${colors[x][0]} ${(i * 100) / subs.length}% ${((i + 1) * 100) / subs.length}%`).join(', ')})`;
const programs: {
  title: string; subjects: string[]; format: 'In person' | 'Live online' | 'On-demand'; grades: string[]; desc: string;
  meeting: string; duration: string; cost: string; location?: string; kind: 'sessions' | 'ondemand' | 'oneToOne';
}[] = [
  {"title": "Kitchen Table Economics", "subjects": ["Math", "Social Studies"], "format": "In person", "grades": ["3–5"], "desc": "Learners plan their own pop-up market business: choosing what to sell, setting prices, building a budget, and figuring out whether they turned a profit. We run mock markets during class so every learner practices the whole experience, and they leave ready to run a real market on their own if they want to. Basic supplies are included; materials for a learner’s own market depend on what they choose to sell and aren’t included.", "meeting": "90 minutes, once a week", "duration": "7 weeks", "cost": "$30/hour · $315 total · basic supplies included", "kind": "sessions", "location": "Northeast Regional Park"},
  {"title": "Build It: Bridges & Towers", "subjects": ["Science", "Math"], "format": "In person", "grades": ["3–5", "6–8"], "desc": "An architecture class built around one question: what makes a structure strong? Learners design, build, and load-test bridges and towers, then use what broke to build better ones. Along the way they learn about forces, materials, and engineering design.", "meeting": "90 minutes, once a week", "duration": "6 weeks", "cost": "$30/hour · $270 total · supplies included", "kind": "sessions", "location": "Northeast Regional Park"},
  {"title": "Central Florida Field Guide", "subjects": ["Science", "Art"], "format": "In person", "grades": ["K–2"], "desc": "Each week we explore a different Central Florida park, observing, sketching, and identifying the plants, animals, and habitats we find. Over time, learners build their own illustrated field guide to share with their families.", "meeting": "60 minutes, once a week", "duration": "Ongoing", "cost": "$30/hour · $30 per session · supplies included", "kind": "sessions", "location": "A different Central Florida park each week (schedule shared in advance)"},
  {"title": "Phonics Through Play", "subjects": ["ELA"], "format": "In person", "grades": ["K–2"], "desc": "Early readers build phonics skills through hands-on games, building, and movement in a small group. Practicing sounds and words feels like play, and confidence grows each week.", "meeting": "60 minutes, once a week", "duration": "Ongoing", "cost": "$30/hour · $30 per session · supplies included", "kind": "sessions", "location": "Cagan Crossings Library or Cooper Memorial Library"},
  {"title": "Writing Workshop", "subjects": ["ELA"], "format": "Live online", "grades": ["3–5", "6–8"], "desc": "Learners write for real audiences, including letters, reviews, and how-to guides, and get feedback to revise each piece. The session ends with a polished final piece shared with a real audience.", "meeting": "60 minutes, once a week", "duration": "10 weeks", "cost": "$15/hour · $150 total", "kind": "sessions"},
  {"title": "Literature-Based Book Club", "subjects": ["ELA"], "format": "Live online", "grades": ["6–8"], "desc": "Learners help choose the books, lead the discussions, and create projects that grow out of the reading. They build close-reading and discussion skills alongside peers who love books.", "meeting": "60 minutes, every other week", "duration": "Ongoing", "cost": "$15/hour · $15 per session", "kind": "sessions"},
  {"title": "Creative Writing Sessions", "subjects": ["ELA"], "format": "Live online", "grades": ["9–12"], "desc": "Teens write fiction, poetry, and personal essays, get real feedback from the instructor and peers, and finish with a portfolio of revised work.", "meeting": "60 minutes, once a week", "duration": "8 weeks", "cost": "$15/hour · $120 total", "kind": "sessions"},
  {"title": "Mapmakers: Geography by Road Trip", "subjects": ["Social Studies", "Math"], "format": "On-demand", "grades": ["3–5"], "desc": "Learners plan a cross-country road trip on a budget: mapping routes, exploring regions and their history, and doing the mileage and cost math. The feedback option adds weekly instructor comments on their plans.", "meeting": "Work at your own pace", "duration": "Start anytime", "cost": "$50/week with feedback, or $50/month self-guided", "kind": "ondemand"},
  {"title": "Civics in Action: Run a Campaign", "subjects": ["Social Studies", "ELA"], "format": "In person", "grades": ["6–8"], "desc": "Learners pick a real local issue, research it, build a campaign, and pitch it to a real audience. They learn how local government works and how to make a persuasive case.", "meeting": "90 minutes, once a week", "duration": "8 weeks", "cost": "$30/hour · $360 total · supplies included", "kind": "sessions", "location": "Cagan Crossings Library"},
  {"title": "Start a Business: PBL Unit", "subjects": ["Math", "ELA", "Social Studies"], "format": "On-demand", "grades": ["6–8", "9–12"], "desc": "Learners take their own business idea from plan to pitch, working through market research, budgeting, branding, and a final presentation. It combines math, writing, and economics in one real project.", "meeting": "Work at your own pace", "duration": "Start anytime", "cost": "$50/week with feedback, or $50/month self-guided", "kind": "ondemand"},
  {"title": "Study Skills Coaching", "subjects": ["Electives"], "format": "Live online", "grades": ["6–8", "9–12"], "desc": "One-on-one coaching on planning, note-taking, and time management, built around your learner’s actual coursework. The skills stick because they’re practiced on real assignments.", "meeting": "60 minutes, scheduled by request", "duration": "Flexible", "cost": "$70–110/hour, by grade", "kind": "oneToOne"},
  {"title": "Young Makers Club", "subjects": ["Science", "Art"], "format": "In person", "grades": ["K–2", "3–5"], "desc": "Each month brings a new theme and a new build. Learners design, tinker, and create hands-on projects, which makes it a great after-school outlet for kids who love making things.", "meeting": "90 minutes, once a week", "duration": "Monthly themes", "cost": "$30/hour · $45 per session · supplies included", "kind": "sessions", "location": "Cagan Crossings Library"},
  {"title": "Kitchen Chemistry", "subjects": ["Science", "Math"], "format": "In person", "grades": ["3–5"], "desc": "Learners cook up experiments to discover the science behind food: why bread rises, how emulsions work, and what heat does to sugar. Then they eat the results.", "meeting": "90 minutes, once a week", "duration": "6 weeks", "cost": "$30/hour · $270 total · ingredients and supplies included", "kind": "sessions", "location": "Location to be announced"},
  {"title": "Math Through Play", "subjects": ["Math"], "format": "In person", "grades": ["K–2"], "desc": "Learners build number sense through games, building, measuring, and movement in a small group. Math becomes something they do with their hands, and confidence grows each week.", "meeting": "60 minutes, once a week", "duration": "Ongoing", "cost": "$30/hour · $30 per session · supplies included", "kind": "sessions", "location": "Location to be announced"},
  {"title": "Real-World Money for Teens", "subjects": ["Math", "Social Studies"], "format": "Live online", "grades": ["9–12"], "desc": "First paychecks, taxes, budgets, credit, and what a car or apartment actually costs. Learners finish by building a budget for the life they want after graduation.", "meeting": "60 minutes, once a week", "duration": "8 weeks", "cost": "$15/hour · $120 total", "kind": "sessions"},
  {"title": "Podcast Lab", "subjects": ["ELA", "Electives"], "format": "Live online", "grades": ["6–8", "9–12"], "desc": "Learners research a topic, interview a real person, write a script, and record and publish their own podcast episode, building research, writing, and speaking skills along the way.", "meeting": "60 minutes, once a week", "duration": "8 weeks", "cost": "$15/hour · $120 total", "kind": "sessions"},
  {"title": "Citizen Science Crew", "subjects": ["Science", "Math"], "format": "In person", "grades": ["6–8"], "desc": "Learners collect real data at Florida springs, lakes, and scrub habitats, including water quality and species counts, and contribute it to real research projects. They learn how scientists actually work in the field.", "meeting": "90 minutes, once a week", "duration": "6 weeks", "cost": "$30/hour · $270 total · supplies included", "kind": "sessions", "location": "Rotating Central Florida field sites (schedule shared in advance)"},
  {"title": "History Detectives: Our Town", "subjects": ["Social Studies", "ELA"], "format": "In person", "grades": ["3–5", "6–8"], "desc": "Learners dig into local history through old maps, photos, primary sources, and an interview with a longtime resident, then present what they uncovered to families.", "meeting": "90 minutes, once a week", "duration": "6 weeks", "cost": "$30/hour · $270 total · supplies included", "kind": "sessions", "location": "Location to be announced"},
  {"title": "Game Design Studio", "subjects": ["Math", "ELA", "Electives"], "format": "In person", "grades": ["6–8"], "desc": "Learners design, prototype, and playtest their own board games, learning probability, rule writing, and how to improve a design through feedback. They leave with a game they made.", "meeting": "90 minutes, once a week", "duration": "6 weeks", "cost": "$30/hour · $270 total · supplies included", "kind": "sessions", "location": "Location to be announced"},
  {"title": "Messy Art Studio", "subjects": ["Art"], "format": "In person", "grades": ["K–2", "3–5"], "desc": "Process-over-product art. Learners experiment with paint, clay, collage, and found materials, and the focus is on exploring and creating rather than making a perfect final piece.", "meeting": "60 minutes, once a week", "duration": "Ongoing", "cost": "$30/hour · $30 per session · supplies included", "kind": "sessions", "location": "Location to be announced"},
  {"title": "Debate & Discourse", "subjects": ["ELA", "Social Studies"], "format": "Live online", "grades": ["6–8", "9–12"], "desc": "Learners research both sides of real questions, build evidence-based arguments, and practice debating with respect. They learn to think critically and disagree well.", "meeting": "60 minutes, once a week", "duration": "8 weeks", "cost": "$15/hour · $120 total", "kind": "sessions"},
  {"title": "Life Skills Lab", "subjects": ["Electives"], "format": "In person", "grades": ["9–12"], "desc": "Cooking a real meal, basic car and home maintenance, sewing a button, reading a lease. Teens practice the everyday skills they need and rarely get taught.", "meeting": "90 minutes, once a week", "duration": "8 weeks", "cost": "$30/hour · $360 total · supplies included", "kind": "sessions", "location": "Location to be announced"}
];
---
<Layout title="Programs | Good Mess Learning" active="programs">
<header style="position:relative;padding:56px 56px 88px;display:flex;flex-direction:column;gap:22px">
<div data-sticker="true" style="position:absolute;right:80px;top:56px;transform:rotate(8deg);background:#0BBFB0;color:#1A1220;padding:12px 20px;border-radius:14px;font-family:'Fraunces',serif;font-weight:800;font-size:20px">now forming</div><div data-sticker="true" style="position:absolute;right:250px;top:150px;transform:rotate(-12deg);background:#FFD23F;color:#1A1220;width:124px;height:124px;border-radius:50%;display:flex;align-items:center;justify-content:center;text-align:center;font-family:'Fraunces',serif;font-weight:800;font-size:19px;line-height:1.05">join the<br>waitlist</div>
<div style="position:relative;font-weight:700;font-size:13px;letter-spacing:.12em;text-transform:uppercase;color:#B8246F">Programs</div>
<h1 style="position:relative;margin:0;max-width:820px;font-family:'Fraunces',serif;font-variation-settings:'SOFT' 100;font-weight:900;font-size:clamp(52px,7vw,92px);line-height:.96;letter-spacing:-.03em;color:#1A1220;text-wrap:balance">Find your next <em style="color:#E8359A">good mess.</em></h1>
<p style="position:relative;margin:0;max-width:620px;font-size:20px;line-height:1.6;color:#4A3F4E;text-wrap:pretty">Classes, clubs, and units. Filter by grade, subject, or format.</p>
</header><section style="padding:0 56px 32px">
<div style="background:#fff;border-radius:24px;box-shadow:0 10px 30px rgba(26,18,32,.08);padding:24px 28px;display:flex;flex-direction:column;gap:14px">
<div style="display:flex;flex-wrap:wrap;align-items:center;gap:8px"><span style="width:72px;font-weight:700;font-size:13px;letter-spacing:.08em;text-transform:uppercase;color:#4A3F4E">Grade</span><button type="button" class="chip" data-filter="grade" data-value="All" aria-pressed="true">All</button><button type="button" class="chip" data-filter="grade" data-value="K–2" aria-pressed="false">K–2</button><button type="button" class="chip" data-filter="grade" data-value="3–5" aria-pressed="false">3–5</button><button type="button" class="chip" data-filter="grade" data-value="6–8" aria-pressed="false">6–8</button><button type="button" class="chip" data-filter="grade" data-value="9–12" aria-pressed="false">9–12</button></div><div style="display:flex;flex-wrap:wrap;align-items:center;gap:8px"><span style="width:72px;font-weight:700;font-size:13px;letter-spacing:.08em;text-transform:uppercase;color:#4A3F4E">Subject</span><button type="button" class="chip" data-filter="subject" data-value="All" aria-pressed="true">All</button><button type="button" class="chip" data-filter="subject" data-value="Math" aria-pressed="false">Math</button><button type="button" class="chip" data-filter="subject" data-value="Science" aria-pressed="false">Science</button><button type="button" class="chip" data-filter="subject" data-value="ELA" aria-pressed="false">ELA</button><button type="button" class="chip" data-filter="subject" data-value="Social Studies" aria-pressed="false">Social Studies</button><button type="button" class="chip" data-filter="subject" data-value="Art" aria-pressed="false">Art</button><button type="button" class="chip" data-filter="subject" data-value="Electives" aria-pressed="false">Electives</button><span style="font-size:13px;color:#7A6D7E;margin-left:4px">pick as many as you like</span></div><div style="display:flex;flex-wrap:wrap;align-items:center;gap:8px"><span style="width:72px;font-weight:700;font-size:13px;letter-spacing:.08em;text-transform:uppercase;color:#4A3F4E">Format</span><button type="button" class="chip" data-filter="format" data-value="All" aria-pressed="true">All</button><button type="button" class="chip" data-filter="format" data-value="In person" aria-pressed="false">In person</button><button type="button" class="chip" data-filter="format" data-value="Live online" aria-pressed="false">Live online</button><button type="button" class="chip" data-filter="format" data-value="On-demand" aria-pressed="false">On-demand</button></div>
</div>
</section>
<section style="padding:16px 56px 112px;display:flex;flex-direction:column;gap:28px">
<div style="display:flex;justify-content:space-between;align-items:baseline;gap:16px"><span id="count" aria-live="polite" style="font-weight:700;font-size:15px"></span><button type="button" id="reset" style="background:none;border:none;color:#B8246F;font-weight:700;font-size:15px;cursor:pointer;padding:0">Clear filters</button></div>

<div id="grid" style="display:grid;grid-template-columns:1fr;gap:28px;align-items:stretch">
{programs.map((p) => (
<article data-program data-grades={p.grades.join('|')} data-subjects={p.subjects.join('|')} data-format={p.format} style={`background:#fff;box-shadow:0 10px 30px rgba(26,18,32,.10);border-top:10px solid transparent;border-image:${stripe(p.subjects)} 1;padding:26px 24px;display:flex;flex-direction:column;gap:14px;height:100%`} data-h="11">
<div style="display:flex;flex-wrap:wrap;gap:8px">{p.subjects.map((sub) => <span style={`background:${colors[sub][1]};padding:5px 11px;border-radius:999px;font-weight:700;font-size:12px`}>{sub}</span>)}<span style="background:#F3EEF1;padding:5px 11px;border-radius:999px;font-weight:600;font-size:12px">{p.format}</span>{p.kind === 'oneToOne' && <span style="background:#F3EEF1;padding:5px 11px;border-radius:999px;font-weight:600;font-size:12px">1:1</span>}<span style="background:#F3EEF1;padding:5px 11px;border-radius:999px;font-weight:600;font-size:12px">Grades {p.grades.join(', ')}</span></div>
<h3 style="margin:0;font-family:'Fraunces',serif;font-weight:700;font-size:24px;line-height:1.15;color:#1A1220">{p.title}</h3>
<p style="margin:0;font-size:15px;line-height:1.6;color:#4A3F4E">{p.desc}</p>
<dl style="margin:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,200px),1fr));gap:10px 24px;font-size:15px;color:#1A1220">
<div><dt style="font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#7A6D7E">Meeting</dt><dd style="margin:2px 0 0;font-weight:700">{p.meeting}</dd></div>
<div><dt style="font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#7A6D7E">Session</dt><dd style="margin:2px 0 0;font-weight:700">{p.duration}</dd></div>
<div><dt style="font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#7A6D7E">Cost</dt><dd style="margin:2px 0 0;font-weight:700">{p.cost.split(' · ')[0]}{p.cost.split(' · ')[1] && <> · <span style="color:#B8246F">{p.cost.split(' · ')[1]}</span></>}{p.cost.split(' · ')[2] && <span style="display:block;font-weight:400;font-size:14px;color:#4A3F4E">{p.cost.split(' · ').slice(2).join(' · ')}</span>}</dd></div>
</dl>
<div style="margin-top:auto;padding-top:14px;border-top:1px dashed #CFC3CC;display:flex;flex-direction:column;gap:10px">
{p.kind === 'sessions' && (
<a class="session" href={contactLink({ type: 'waitlist', program: p.title, session: 'To be scheduled', interest: 'Small-group classes' })}>
<span style="display:flex;flex-direction:column;gap:2px"><strong style="font-size:16px">Now forming</strong>{p.location && <span style="font-size:14px;color:#4A3F4E">{p.location}</span>}</span>
<span class="s-cta">Join the waitlist →</span>
</a>
)}
{p.kind === 'ondemand' && (
<div style="display:flex;flex-wrap:wrap;gap:10px"><a class="btn-solid" href={contactLink({ type: 'sign-up-with-feedback', program: p.title })}>Sign up with feedback</a><a class="btn-line" href={contactLink({ type: 'sign-up-self-guided', program: p.title })}>Sign up self-guided</a></div>
)}
{p.kind === 'oneToOne' && (
<div><a class="btn-solid" href={contactLink({ type: 'request-a-time', program: p.title, interest: 'Private tutoring' })}>Request a time</a></div>
)}
</div>
</article>
))}
</div>

<div id="none" hidden style="background:#fff;border:3px dashed #CFC3CC;border-radius:24px;padding:56px;text-align:center;display:flex;flex-direction:column;gap:10px;align-items:center"><h3 style="margin:0;font-family:'Fraunces',serif;font-weight:700;font-size:26px">Nothing here yet.</h3><p style="margin:0;color:#4A3F4E;max-width:460px">Try another filter, or tell us what you're looking for. New programs open every season, and many start from a family's request.</p><a href="/contact/" style="font-weight:700">Request a program →</a></div>

<p style="margin:0;font-size:14px;color:#7A6D7E">All programs are FES-UA &amp; PEP eligible through Step Up for Students. <a href="/pricing/">How to pay →</a></p>
</section>
<section style="padding:0 56px 96px">
<div style="background:#E8359A;border-radius:40px;padding:72px;display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:40px;position:relative;overflow:hidden">
<div style="position:absolute;right:220px;bottom:-90px;width:200px;height:200px;border-radius:50%;background:#FFD23F"></div>
<h2 style="position:relative;margin:0;font-family:'Fraunces',serif;font-variation-settings:'SOFT' 100;font-weight:900;font-size:56px;line-height:1;color:#FDFAF6;max-width:640px">Don't see the right fit? We'll build one.</h2>
<a href="/contact/" style="position:relative;background:#1A1220;color:#FDFAF6;text-decoration:none;padding:18px 32px;border-radius:999px;font-weight:700;font-size:17px;white-space:nowrap" data-h="8">Tell us what you need</a>
</div>
</section>
<script is:inline>
  (function () {
    var fresh = function () { return { grade: 'All', subject: [], format: 'All' }; };
    var state = fresh();
    var chips = document.querySelectorAll('.chip');
    var cards = document.querySelectorAll('[data-program]');
    var grid = document.getElementById('grid');
    var none = document.getElementById('none');
    var count = document.getElementById('count');
    function apply() {
      var n = 0;
      cards.forEach(function (c) {
        var subjects = c.dataset.subjects.split('|');
        var ok = (state.grade === 'All' || c.dataset.grades.split('|').indexOf(state.grade) > -1) &&
          (state.subject.length === 0 || state.subject.some(function (s) { return subjects.indexOf(s) > -1; })) &&
          (state.format === 'All' || c.dataset.format === state.format);
        c.style.display = ok ? '' : 'none';
        if (ok) n++;
      });
      chips.forEach(function (b) {
        var f = b.dataset.filter, v = b.dataset.value;
        var on = f === 'subject' ? (v === 'All' ? state.subject.length === 0 : state.subject.indexOf(v) > -1) : state[f] === v;
        b.setAttribute('aria-pressed', on ? 'true' : 'false');
      });
      count.textContent = n + (n === 1 ? ' program' : ' programs');
      grid.style.display = n ? 'grid' : 'none';
      none.style.display = n ? 'none' : 'flex';
    }
    chips.forEach(function (b) {
      b.addEventListener('click', function () {
        var f = b.dataset.filter, v = b.dataset.value;
        if (f === 'subject') {
          // Subjects are multi-select: click to add or remove; "All" clears.
          if (v === 'All') state.subject = [];
          else {
            var i = state.subject.indexOf(v);
            if (i > -1) state.subject.splice(i, 1); else state.subject.push(v);
          }
        } else {
          state[f] = v;
        }
        apply();
      });
    });
    document.getElementById('reset').addEventListener('click', function () { state = fresh(); apply(); });
    apply();
  })();
</script>
</Layout>
